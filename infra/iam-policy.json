{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3EventBannerAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::eventhive-event-banners",
        "arn:aws:s3:::eventhive-event-banners/*"
      ]
    },
    {
      "Sid": "RDSConnectAccess",
      "Effect": "Allow",
      "Action": [
        "rds-db:connect"
      ],
      "Resource": [
        "arn:aws:rds:<REGION>:<ACCOUNT_ID>:db:eventhive-db"
      ]
    }
  ]
}
